APP_NAME=demo-service
APP_VERSION=1.0.0
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=./logs
LOG_TO_FILE=false
TIMEZONE=Asia/Shanghai
METRICS_TOKEN=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECT_TIMEOUT=1
REDIS_TIMEOUT=2

CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false

# Gateway-injected identity / service-side fine-grained authorization
TRUSTED_PROXY_TOKEN=
AUTHZ_BASE_URL=http://authz-svc:8000
AUTHZ_TIMEOUT_SECONDS=3
AUTHZ_CACHE_TTL_SECONDS=30
INTERNAL_API_TOKEN=

# Async PostgreSQL idempotency + optional RabbitMQ transactional outbox
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
EVENT_ENABLED=false
EVENT_BROKER_URL=
EVENT_EXCHANGE=service.events
EVENT_DLX_EXCHANGE=service.events.dlx
EVENT_QUEUE=
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_SECONDS=1
