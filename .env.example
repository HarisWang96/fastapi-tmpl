# ============================================================
# Example application configuration; copy to .env and add real values.
# .env is gitignored; never commit credentials.
# Configure multiple databases as JSON in one environment variable.
# ============================================================

APP_NAME=fastapi-svc
APP_VERSION=0.1.0
APP_ENV=dev
DEBUG=false
API_PREFIX=/api/v1
# Defaults are production-oriented; this example explicitly enables local development settings.
CORS_ORIGINS=["*"]
# Naive DATETIME values use this business timezone, independent of the container timezone.
TIMEZONE=Asia/Shanghai

LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_RETENTION="7 days"
# Write logs to files locally. Docker overrides this to false because workers must not
# rotate the same file; containers write to stderr for log collection.
LOG_TO_FILE=true
LOG_FORMAT=text
# Optional outside production; mandatory in prod to protect /metrics.
METRICS_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- MySQL ----
DB_CHARSET=utf8mb4
MYSQL_POOL_MAX_CONNECTIONS=20
MYSQL_POOL_TIMEOUT=10
MYSQL_POOL_RECYCLE=1800
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_DATABASES={"default":{"host":"mysql.example.internal","port":3306,"user":"CHANGE_ME","password":"CHANGE_ME","database":"CHANGE_ME"}}

# ---- Redis ----
REDIS_DEFAULT_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECT_TIMEOUT=1
REDIS_TIMEOUT=2
REDIS_DATABASES={"default":{"host":"redis.example.internal","port":6379,"username":"CHANGE_ME","password":"CHANGE_ME"}}
# Dependencies that must be available for readiness. Set [] if none are mandatory.
READINESS_DEPENDENCIES=["mysql","redis"]

# ---- Gateway identity headers ----
# Downstream services do not parse JWTs; the gateway injects X-User-Id / X-App-Id after validation.
# Production requires this token. Configure the same secret in the gateway and
# restrict service ingress to the gateway with NetworkPolicy.
TRUSTED_PROXY_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- Authorization (PDP: authz-svc) ----
# Fine-grained permission and data-scope checks run in this service, not at the gateway.
AUTHZ_BASE_URL=http://authz-svc:8000
AUTHZ_TIMEOUT_SECONDS=3
# Max staleness for a cached allow/deny decision; 0 disables the cache.
AUTHZ_CACHE_TTL_SECONDS=30
# Must match authz-svc INTERNAL_API_TOKEN. Production requires it.
INTERNAL_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- Idempotency (write endpoints accepting Idempotency-Key) ----
IDEMPOTENCY_TTL_SECONDS=86400
# Expired rows are purged periodically; 0 disables the cleaner.
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600

# ---- Events (transactional outbox + RabbitMQ) ----
# Disabled by default: a service that never emits/consumes events needs no broker.
EVENT_ENABLED=false
EVENT_BROKER_URL=amqp://CHANGE_ME:CHANGE_ME@rabbitmq:5672/
EVENT_EXCHANGE=meihao.events
EVENT_DLX_EXCHANGE=meihao.events.dlx
# Consumer queue name; empty means "<APP_NAME>.events".
EVENT_QUEUE=
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=10
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_SECONDS=1
